      { location: "R-50", name: "人蔘鬚(1)", alias: "" },
      { location: "R-51", name: "當歸", alias: "" },
      { location: "R-52", name: "當歸尾", alias: "" },
      { location: "R-53", name: "無籽紅棗", alias: "" },
      { location: "R-54", name: "紅棗", alias: "" },
      { location: "R-55", name: "延胡索", alias: "" },
      { location: "R-56", name: "蓮子心", alias: "" },
      { location: "R-57", name: "麥芽糖", alias: "" },
      { location: "R-58", name: "紅棗切片", alias: "" },
      { location: "R-59", name: "海馬", alias: "" },
      { location: "R-60", name: "山茱萸(酒)", alias: "" },
      { location: "R-61", name: "綠豆", alias: "" },
      { location: "R-62", name: "全蠍", alias: "" }
    ];

    // 💡 取得在地當前日期 (YYYY-MM-DD)，避開 UTC 時區造成的少一天問題
    const getTodayString = () => {
      const d = new Date();
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    function compressImage(file, maxWidth, quality, callback) {
      var reader = new FileReader();
      reader.onload = function(e) {
        var img = new Image();
        img.onload = function() {
          var canvas = document.createElement('canvas');
          var width = img.width;
          var height = img.height;

          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }

          canvas.width = width;
          canvas.height = height;

          var ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          var base64 = canvas.toDataURL('image/jpeg', quality).split(',')[1];
          callback(base64);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    createApp({
      setup() {
        const currentTab = ref('overview');
        const searchKeyword = ref('');
        const selectedCabinet = ref('ALL');
        
        const selectedWarnings = ref([]);
        const isWarningDropdownOpen = ref(false);

        const logFormHeader = reactive({
          date: getTodayString(), // 👈 修正處：使用在地日期
          type: '進貨',
          operator: '',
          note: ''
        });
        const cardSearchKeyword = ref('');
        const onlyRecognized = ref(false);

        const itemBatchInputs = reactive({});

        const dbLogs = ref([]);
        const loading = ref(false);
        const submitting = ref(false);
        const analyzing = ref(false);

        const historyFilterType = ref('ALL');
        const historyFilterDate = ref('ALL');

        const availableDates = computed(() => {
          const dates = dbLogs.value.map(log => log.date || log.timestamp).filter(Boolean);
          return [...new Set(dates)].sort((a, b) => new Date(b) - new Date(a));
        });

        const groupedLogs = computed(() => {
          let filtered = dbLogs.value.filter(log => {
            const logType = log.type || '';
            const logDate = log.date || log.timestamp || '';

            if (historyFilterType.value !== 'ALL') {
              if (historyFilterType.value === '出庫' && !logType.includes('出')) return false;
              if (historyFilterType.value === '盤點' && !logType.includes('盤')) return false;
              if (historyFilterType.value === '進貨' && logType !== '進貨') return false;
            }

            if (historyFilterDate.value !== 'ALL' && logDate !== historyFilterDate.value) {
              return false;
            }

            return true;
          });

          const groups = {};
          filtered.forEach(log => {
            const d = log.date || log.timestamp || '未分類日期';
            if (!groups[d]) groups[d] = [];
            groups[d].push(log);
          });

          return groups;
        });

        const getItemBatches = (key) => {
          if (!itemBatchInputs[key]) {
            itemBatchInputs[key] = [{ qty: null, expDate: '' }];
          }
          return itemBatchInputs[key];
        };

        const addBatchRow = (key) => {
          const batches = getItemBatches(key);
          batches.push({ qty: null, expDate: '' });
        };

        const removeBatchRow = (key, index) => {
          const batches = getItemBatches(key);
          if (batches.length > 1) {
            batches.splice(index, 1);
          }
        };

        const getItemTotalQty = (key) => {
          const batches = itemBatchInputs[key];
          if (!batches) return 0;
          return batches.reduce((sum, b) => sum + (Number(b.qty) || 0), 0);
        };

        const inventoryList = computed(() => {
          return rawHerbData.map(herb => {
            let totalQty = 0;
            const expBatchMap = {};

            const herbLogs = dbLogs.value
              .filter(log => log.name === herb.name && log.location === herb.location)
              .slice()
              .sort((a, b) => {
                const dateA = a.date || a.timestamp || '';
                const dateB = b.date || b.timestamp || '';
                if (dateA !== dateB) return dateA.localeCompare(dateB);
                const idA = a.id || '';
                const idB = b.id || '';
                return idA.localeCompare(idB);
              });

            let currentStocktakeBatch = null;

            herbLogs.forEach(log => {
              const logQty = Number(log.qty) || 0;
              const rawExp = log.expDate ? log.expDate.trim() : '未填效期';
              const logDate = log.date || log.timestamp || '';

              let submissionTime = '';
              if (log.id && log.id.startsWith('INV_')) {
                submissionTime = log.id.split('_')[1] || '';
              }

              if (log.type === '進貨') {
                totalQty += logQty;
                expBatchMap[rawExp] = Number(((expBatchMap[rawExp] || 0) + logQty).toFixed(4));
                currentStocktakeBatch = null;
              } else if (log.type === '出庫' || log.type === '出貨') {
                totalQty -= logQty;
                let deductQty = logQty;

                const sortedExpKeys = Object.keys(expBatchMap).sort((a, b) => {
                  if (a === '未填效期') return 1;
                  if (b === '未填效期') return -1;
                  return new Date(a) - new Date(b);
                });

                for (const expKey of sortedExpKeys) {
                  if (deductQty <= 0) break;
                  const currentExpQty = expBatchMap[expKey] || 0;
                  if (currentExpQty > 0) {
                    if (currentExpQty >= deductQty) {
                      // 修正點：加上 .toFixed(4) 避免浮點數精確度誤差
                      expBatchMap[expKey] = Number((currentExpQty - deductQty).toFixed(4));
                      deductQty = 0;
                    } else {
                      deductQty = Number((deductQty - currentExpQty).toFixed(4));
                      expBatchMap[expKey] = 0;
                    }
                  }
                }
                currentStocktakeBatch = null;
              } else if (log.type === '盤點' || log.type === '盤點修正') {
                const sessionKey = submissionTime ? `${logDate}_${submissionTime}` : `${logDate}_${log.operator || ''}_stocktake`;

                if (currentStocktakeBatch === sessionKey) {
                  totalQty += logQty;
                  expBatchMap[rawExp] = Number(((expBatchMap[rawExp] || 0) + logQty).toFixed(4));
                } else {
                  totalQty = logQty;
                  Object.keys(expBatchMap).forEach(k => expBatchMap[k] = 0);
                  expBatchMap[rawExp] = logQty;
                  currentStocktakeBatch = sessionKey;
                }
              }
            });

            // 修正總庫存小數點誤差
            totalQty = Number(totalQty.toFixed(4));

            const expList = [];
            const sortedExpKeys = Object.keys(expBatchMap).sort((a, b) => {
              if (a === '未填效期') return 1;
              if (b === '未填效期') return -1;
              return new Date(a) - new Date(b);
            });

            sortedExpKeys.forEach(expKey => {
              // 修正點：自動去除小數點多餘的 0，呈現乾淨數值
              const batchQty = Number(expBatchMap[expKey].toFixed(4));
              if (batchQty > 0) {
                expList.push({
                  rawDate: expKey,
                  formattedText: `${expKey}*${batchQty}`
                });
              }
            });

            return { 
              ...herb, 
              currentQty: totalQty < 0 ? 0 : totalQty, 
              expList: expList
            };
          });
        });

        const getExpStatusClass = (expDateStr) => {
          if (!expDateStr || expDateStr === '未填效期') {
            return 'bg-gray-100 text-gray-600 border border-gray-200';
          }

          const today = new Date();
          today.setHours(0, 0, 0, 0);

          const expDate = new Date(expDateStr);
          expDate.setHours(0, 0, 0, 0);

          if (isNaN(expDate.getTime())) {
            return 'bg-gray-100 text-gray-600 border border-gray-200';
          }

          const sixMonthsLater = new Date(today);
          sixMonthsLater.setMonth(today.getMonth() + 6);

          if (expDate < today) {
            return 'bg-red-500 text-white border border-red-600 font-bold shadow-sm';
          } else if (expDate <= sixMonthsLater) {
            return 'bg-yellow-300 text-yellow-950 border border-yellow-400 font-bold shadow-sm';
          } else {
            return 'bg-slate-100 text-slate-700 border border-slate-200';
          }
        };

        const checkItemWarning = (item, warningType) => {
          if (warningType === 'LOW_STOCK') {
            return item.currentQty <= 5;
          }

          if (!item.expList || item.expList.length === 0) return false;

          const today = new Date();
          today.setHours(0, 0, 0, 0);

          return item.expList.some(exp => {
            if (!exp.rawDate || exp.rawDate === '未填效期') return false;
            const expDate = new Date(exp.rawDate);
            if (isNaN(expDate.getTime())) return false;
            expDate.setHours(0, 0, 0, 0);

            const diffTime = expDate - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (warningType === 'EXPIRED') return diffDays < 0;
            if (warningType === 'EXP_3M') return diffDays >= 0 && diffDays <= 90;
            if (warningType === 'EXP_6M') return diffDays >= 0 && diffDays <= 180;
            return false;
          });
        };

        const filteredInventory = computed(() => {
          return inventoryList.value.filter(item => {
            const matchKw = !searchKeyword.value || 
                            item.name.includes(searchKeyword.value) || 
                            item.alias.includes(searchKeyword.value) || 
                            item.location.toLowerCase().includes(searchKeyword.value.toLowerCase());
            
            let matchCab = true;
            if (selectedCabinet.value !== 'ALL') {
              if (selectedCabinet.value === 'G') matchCab = item.location.startsWith('G');
              else if (selectedCabinet.value === 'R') matchCab = item.location.startsWith('R');
              else matchCab = (item.location.split('-')[0] === selectedCabinet.value);
            }

            let matchWarn = true;
            if (selectedWarnings.value.length > 0) {
              matchWarn = selectedWarnings.value.some(w => checkItemWarning(item, w));
            }

            return matchKw && matchCab && matchWarn;
          });
        });

        const hasRecognizedItems = computed(() => {
          return Object.keys(itemBatchInputs).some(key => getItemTotalQty(key) > 0);
        });

        const recognizedCount = computed(() => {
          return Object.keys(itemBatchInputs).filter(key => getItemTotalQty(key) > 0).length;
        });

        const cardFilteredInventory = computed(() => {
          return inventoryList.value.filter(item => {
            const key = item.location + '|' + item.name;
            
            if (onlyRecognized.value) {
              if (getItemTotalQty(key) <= 0) return false;
            }

            if (cardSearchKeyword.value) {
              const kw = cardSearchKeyword.value.toLowerCase();
              const matchKw = item.name.includes(kw) || 
                              item.alias.includes(kw) || 
                              item.location.toLowerCase().includes(kw);
              if (!matchKw) return false;
            }

            return true;
          });
        });

        const fetchLogs = async () => {
          if (!GAS_URL) return;
          loading.value = true;
          try {
            const res = await fetch(GAS_URL);
            dbLogs.value = await res.json();
          } catch (err) { 
            alert('連線雲端資料庫失敗！'); 
          } finally { 
            loading.value = false; 
          }
        };

        const handleImageUpload = (event) => {
          const file = event.target.files[0];
          if (!file) return;

          analyzing.value = true;

          const autoDict = {};
          rawHerbData.forEach(herb => {
            if (herb.alias) {
              const aliases = herb.alias.split(/[.、,]/);
              aliases.forEach(a => {
                const cleanA = a.trim();
                if (cleanA) autoDict[cleanA] = herb.name;
              });
            }
          });

          compressImage(file, 1600, 0.85, async (base64Image) => {
            try {
              const res = await fetch(GAS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain' },
                body: JSON.stringify({ 
                  action: 'analyze_image', 
                  image: base64Image,
                  dictionary: autoDict 
                })
              });
              
              const rawText = await res.text();
              let result;
              
              try {
                result = JSON.parse(rawText);
              } catch (pErr) {
                let clean = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();
                const firstBracket = clean.search(/[\{\[]/);
                const lastBracket = Math.max(clean.lastIndexOf('}'), clean.lastIndexOf(']'));
                if (firstBracket !== -1 && lastBracket !== -1) {
                  clean = clean.substring(firstBracket, lastBracket + 1);
                  result = JSON.parse(clean);
                } else {
                  throw pErr;
                }
              }

              if (result.error || result.status === 'error') {
                alert('Gemini AI 辨識失敗：\n' + (result.message || result.error));
                return;
              }

              if (result.status === 'success' && result.data && result.data.length > 0) {
                let matchedCount = 0;
                
                result.data.forEach(item => {
                  if (!item.name) return;
                  
                  const cleanAiName = item.name.replace(/\(.*\)/g, '').replace(/（.*）/g, '').trim();

                  const matchedHerb = rawHerbData.find(h => {
                    const cleanHerbName = h.name.replace(/\(.*\)/g, '').replace(/（.*）/g, '').trim();
                    return cleanHerbName === cleanAiName ||
                           cleanHerbName.includes(cleanAiName) || 
                           cleanAiName.includes(cleanHerbName) ||
                           (h.alias && h.alias.includes(cleanAiName));
                  });

                  if (matchedHerb) {
                    const key = matchedHerb.location + '|' + matchedHerb.name;
                    
                    if (!itemBatchInputs[key] || (itemBatchInputs[key].length === 1 && !itemBatchInputs[key][0].qty)) {
                      itemBatchInputs[key] = [{ qty: item.qty, expDate: item.expDate || '' }];
                    } else {
                      itemBatchInputs[key].push({ qty: item.qty, expDate: item.expDate || '' });
                    }
                    matchedCount++;
                  }
                });

                if (matchedCount > 0) {
                  onlyRecognized.value = true;
                } else {
                  alert('AI 有辨識出文字（' + result.data.map(d => d.name).join(', ') + '），但與系統內的藥材名稱無法完全對應，請檢查藥名或手動填寫。');
                }
              } else {
                alert('AI 未能成功辨識單據內容，請確保照片光線充足、文字清晰且平整。');
              }
            } catch (err) {
              console.error(err);
              alert('辨識過程發生連線錯誤或解析失敗：\n' + (err.message || err));
            } finally {
              analyzing.value = false;
              event.target.value = '';
            }
          });
        };

        const submitBatchLogs = async () => {
          const newEntries = [];
          const now = Date.now();
          
          for (const key in itemBatchInputs) {
            const batches = itemBatchInputs[key];
            const [loc, name] = key.split('|');

            batches.forEach((b, idx) => {
              const qty = Number(b.qty);
              if (qty && qty > 0) {
                newEntries.push({
                  id: 'INV_' + now + '_' + Math.floor(Math.random()*10000) + '_' + idx,
                  date: logFormHeader.date,
                  type: logFormHeader.type,
                  location: loc,
                  name: name,
                  qty: qty,
                  expDate: b.expDate || '',
                  operator: logFormHeader.operator.trim(),
                  note: logFormHeader.note.trim()
                });
              }
            });
          }

          if (newEntries.length === 0) {
            return alert('請至少在一個藥材右側輸入數量！');
          }

          submitting.value = true;
          try {
            await fetch(GAS_URL, { method: 'POST', body: JSON.stringify({ action: 'add', data: newEntries }) });
            
            for (const key in itemBatchInputs) {
              itemBatchInputs[key] = [{ qty: null, expDate: '' }];
            }
            logFormHeader.note = '';
            logFormHeader.date = getTodayString(); // 👈 修正處：送出後重置為當日在地日期
            onlyRecognized.value = false;
            
            alert(`成功發送 ${newEntries.length} 筆異動紀錄！`);
            await fetchLogs();
            currentTab.value = 'overview';
          } catch (err) { 
            alert('傳送失敗！'); 
          } finally { 
            submitting.value = false; 
          }
        };

        const deleteLog = async (id) => {
          if (confirm('確定要刪除這筆異動紀錄嗎？')) {
            dbLogs.value = dbLogs.value.filter(log => log.id !== id);
            await fetch(GAS_URL, { method: 'POST', body: JSON.stringify({ action: 'delete', id: id }) });
          }
        };

        onMounted(() => { fetchLogs(); });

        return {
          currentTab, searchKeyword, selectedCabinet, selectedWarnings, isWarningDropdownOpen,
          logFormHeader, cardSearchKeyword, cardFilteredInventory,
          onlyRecognized, hasRecognizedItems, recognizedCount,
          getItemBatches, addBatchRow, removeBatchRow, getItemTotalQty,
          dbLogs, loading, submitting, analyzing, rawHerbData,
          inventoryList, filteredInventory, fetchLogs, submitBatchLogs, deleteLog, getExpStatusClass, handleImageUpload,
          historyFilterType, historyFilterDate, availableDates, groupedLogs
        };
      }
    }).mount('#app');
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>院所品項調撥與後台統計系統 (云端雲端連線版)</title>
  <!-- 引入 Tailwind CSS 與 Vue.js -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
</head>
<body class="bg-gray-100 p-4 md:p-6">
  <div id="app" class="max-w-6xl mx-auto">
    <!-- 頁籤切換：前台輸入 vs 後台管理 -->
    <div class="flex border-b border-gray-300 mb-6 bg-white rounded-t-lg shadow">
      <button @click="currentTab = 'input'" :class="['px-6 py-3 font-bold', currentTab === 'input' ? 'border-b-2 border-blue-600 text-blue-600' : 'text-gray-500']">
        📝 填寫調撥單
      </button>
      <button @click="currentTab = 'admin'; fetchLogs()" :class="['px-6 py-3 font-bold flex items-center gap-2', currentTab === 'admin' ? 'border-b-2 border-blue-600 text-blue-600' : 'text-gray-500']">
        📊 後台管理與歷史查詢
        <span v-if="loading" class="animate-spin text-xs">🌀</span>
      </button>
    </div>

    <!-- 1. 前端填寫頁面 -->
    <div v-if="currentTab === 'input'" class="bg-white p-6 rounded-lg shadow">
      <div class="flex justify-between items-center mb-4 border-b pb-3">
        <h2 class="text-xl font-bold text-gray-800">院所調撥單輸入（共 {{ items.length }} 項）</h2>
        <span class="text-sm font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full">已填寫 {{ activeItemsCount }} 項</span>
      </div>
      
      <!-- 院所資訊與日期欄位 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 bg-gray-50 p-4 rounded-lg border">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">📅 調撥日期</label>
          <input type="date" v-model="orderDate" class="border p-2 rounded w-full bg-white focus:ring-2 focus:ring-blue-400">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">🏥 調出院所（提供方）</label>
          <input type="text" v-model="fromClinic" placeholder="請輸入或選擇院所" list="clinic-list" class="border p-2 rounded w-full bg-white focus:ring-2 focus:ring-blue-400">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">🏥 調入力院所（需求方）</label>
          <input type="text" v-model="toClinic" placeholder="請輸入或選擇院所" list="clinic-list" class="border p-2 rounded w-full bg-white focus:ring-2 focus:ring-blue-400">
        </div>
        
        <datalist id="clinic-list">
          <option value="大墩水藥室"></option>
          <option value="大墩"></option>
          <option value="大里"></option>
          <option value="福科"></option>
          <option value="竹北"></option>
          <option value="湖口"></option>
          <option value="南竹水藥室"></option>
        </datalist>
      </div>

      <!-- 關鍵字搜尋 -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">🔍 快速搜尋品項</label>
        <input type="text" v-model="searchKeyword" placeholder="輸入藥名或關鍵字 (如：轉骨、膠囊、面膜)..." class="border p-2 rounded w-full focus:ring-2 focus:ring-blue-400">
      </div>

      <!-- 品項清單 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 max-h-[500px] overflow-y-auto p-2 border rounded bg-gray-50">
        <div v-for="item in filteredItems" :key="item.name" 
             :class="['flex justify-between items-center p-3 border rounded transition-colors', item.qty > 0 ? 'bg-blue-50 border-blue-300' : 'bg-white hover:bg-gray-100']">
          <span class="font-medium text-sm text-gray-800 pr-2">{{ item.name }}</span>
          <input type="number" min="0" placeholder="0" v-model.number="item.qty" class="border p-1 w-20 text-center rounded focus:ring-2 focus:ring-blue-400 font-bold text-blue-800">
        </div>
      </div>

      <button @click="submitOrder" :disabled="submitting" class="mt-6 w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow transition-all text-lg flex justify-center items-center gap-2">
        <span v-if="submitting">資料傳送中...</span>
        <span v-else>送出調撥單（同步至雲端）</span>
      </button>
    </div>

    <!-- 2. 後台統計與歷史查詢頁面 -->
    <div v-if="currentTab === 'admin'" class="bg-white p-6 rounded-lg shadow">
      <div class="flex flex-wrap justify-between items-center border-b pb-3 mb-6 gap-4">
